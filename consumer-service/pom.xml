<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ashfaq.bigdata</groupId>
    <artifactId>big-data-assignment-3</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>consumer-service</artifactId>
  <packaging>jar</packaging>

  <name>consumer-service</name>
  <description>
    Consumes Avro Order records, maintains the running average of prices, retries temporary
    failures across the retry topics, and routes permanent and exhausted failures to the
    dead letter queue.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Real Avro deserialisation through the Confluent Schema Registry. -->
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
    </dependency>

    <!-- The generated Order model, shared with the producer. -->
    <dependency>
      <groupId>com.ashfaq.bigdata</groupId>
      <artifactId>common-avro</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      kafka-schema-registry-client is deliberately NOT declared here. It arrives transitively
      from kafka-avro-serializer at compile scope, which is what the deserializer needs at
      runtime, and a compile-scoped dependency is on the test classpath too - so the
      MockSchemaRegistryClient behind the mock:// URL in the integration tests still resolves.

      Declaring it explicitly with test scope, as this module previously did, silently broke the
      application: Maven's nearest-definition-wins rule let the direct test-scoped declaration
      override the transitive compile-scoped one, so the class was missing at runtime and the
      consumer died on startup with NoClassDefFoundError: RestClientException.
    -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
