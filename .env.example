# ---------------------------------------------------------------------------
# Example environment configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and adjust only if a default conflicts with something
# already running on your machine:
#
#   cp .env.example .env
#
# Every value below is a non-secret local default. The local Kafka broker runs
# PLAINTEXT with no authentication, so this project has no credentials, tokens
# or API keys. Never add one to this file; .env itself is git-ignored.
# ---------------------------------------------------------------------------

# ---- Kafka ----------------------------------------------------------------
# Used by the producer and consumer running on the host JVM.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Used by containers talking to the broker over the Docker network.
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ---- Topics ---------------------------------------------------------------
# Created explicitly by scripts/create-topics.sh; auto-creation is never relied on.
ORDERS_TOPIC=orders.v1
ORDERS_RETRY_TOPIC_0=orders.v1-retry-0
ORDERS_RETRY_TOPIC_1=orders.v1-retry-1
ORDERS_DLT_TOPIC=orders.v1-dlt
TOPIC_PARTITIONS=1
TOPIC_REPLICATION_FACTOR=1

# ---- Consumer and retry policy --------------------------------------------
CONSUMER_GROUP_ID=orders-consumer-v1
# Total processing attempts, including the first. 3 = original + 2 retries.
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=2000

# ---- Host ports -----------------------------------------------------------
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
CONSUMER_PORT=8082
KAFKA_UI_PORT=8090
# The producer uses 8080, not 8081, to avoid colliding with the Schema Registry.
PRODUCER_PORT=8080
